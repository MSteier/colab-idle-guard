{
  "manifest_version": 3,
  "name": "Colab Idle Guard",
  "version": "0.1.0",
  "author": "Mist Technologies",
  "homepage_url": "https://github.com/MSteier/colab-idle-guard",
  "description": "Reports Google Colab activity and cell-execution state to the local Colab Idle Guard app so idle GPU runtimes can be released.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://colab.research.google.com/*"
      ],
      "js": [
        "content/kernel_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://colab.research.google.com/*"
      ],
      "js": [
        "content/colab_probe.js",
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Colab Idle Guard",
    "default_popup": "ui/popup.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  }
}
